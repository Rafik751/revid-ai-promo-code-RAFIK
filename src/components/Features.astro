---
import { features } from '../data/content';
---
<section class="section wrap" id="features">
  <div class="section-head">
    <h2>{features.title}</h2>
    <p>{features.intro}</p>
  </div>

  <ul class="grid">
    {features.items.map((f) => (
      <li>
        <h3>{f.title}</h3>
        <p>{f.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 2.5rem 3rem; }
  li { border-top: 3px solid var(--ink); padding-top: 1rem; display: grid; gap: 0.5rem; align-content: start; }
  li p { color: var(--muted); }
</style>

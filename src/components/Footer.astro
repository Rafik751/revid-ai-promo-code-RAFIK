---
import { site, disclaimer } from '../data/content';
---
<footer class="foot">
  <div class="wrap">
    <p>{disclaimer}</p>
    <p class="meta">Last verified: {site.verified}</p>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--line); padding-block: 2rem 3rem; color: var(--muted); font-size: var(--step--1); }
  .wrap { display: grid; gap: 0.4rem; }
  .meta { font-weight: 650; color: var(--ink); }
</style>

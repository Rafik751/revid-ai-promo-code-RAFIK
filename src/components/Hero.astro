---
import { site, hero } from '../data/content';
---
<section class="hero wrap" id="top">
  <div class="copy">
    <span class="pill pill-ok">Verified {site.verified}</span>
    <h1>{hero.title}</h1>
    <p class="lead">{hero.lead}</p>
  </div>

  <aside class="ticket" id="code" aria-label="Your promo code">
    <div class="ticket-top">
      <p class="label">Your promo code</p>
      <p class="code">{site.code}</p>
      <button type="button" class="btn" data-copy={site.code}>Copy code</button>
      {site.checkoutUrl && <a class="btn btn-ghost" href={site.checkoutUrl} rel="noopener sponsored" target="_blank">Go to checkout</a>}
    </div>
    <div class="ticket-bottom">
      <div class="pills">
        <span class="pill pill-ok">{hero.badges[0]}</span>
        <span class="pill pill-warn">{hero.badges[1]}</span>
      </div>
      <p class="price">
        <span>{hero.plan}</span>
        <span><s>{hero.was}</s> <strong>{hero.now}</strong></span>
      </p>
    </div>
  </aside>
</section>

<style>
  .hero { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(2rem, 6vw, 4.5rem); align-items: center; padding-block: clamp(3rem, 8vw, 6rem); }
  .copy { display: grid; gap: 1.25rem; justify-items: start; }
  .lead { font-size: var(--step-1); line-height: 1.5; color: var(--muted); max-width: 46ch; }

  /* The coupon: two stacked halves with notches and a perforated seam. */
  .ticket { background: var(--surface); border-radius: var(--radius); position: relative; filter: drop-shadow(0 18px 30px rgba(20, 22, 27, 0.12)); }
  .ticket-top, .ticket-bottom { padding: 1.75rem 1.75rem; }
  .ticket-top { display: grid; gap: 1rem; justify-items: start; border-bottom: 2px dashed var(--line); border-radius: var(--radius) var(--radius) 0 0; }
  .label { color: var(--muted); font-size: var(--step--1); font-weight: 500; }
  .code { font: 800 clamp(2.8rem, 2rem + 4vw, 4.2rem) / 1 var(--font-display); letter-spacing: 0.04em; color: var(--accent); }
  .ticket-bottom { display: grid; gap: 1rem; }
  .pills { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .price { display: flex; justify-content: space-between; align-items: baseline; font-weight: 500; gap: 1rem; }
  .price s { color: var(--muted); margin-right: 0.35rem; }
  .price strong { font: 700 1.6rem var(--font-display); }

  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; } }
</style>

---
import { proof } from '../data/content';
---
<section class="section wrap" id="proof">
  <div class="section-head">
    <h2>{proof.title}</h2>
    <p>{proof.intro}</p>
  </div>

  <ol class="steps">
    {proof.steps.map((s, i) => (
      <li>
        <span class="n" aria-hidden="true">{i + 1}</span>
        <div class="body">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          {s.image && <img src={s.image} alt={`Screenshot: ${s.title}`} loading="lazy" />}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; max-width: 46rem; }
  li { display: grid; grid-template-columns: 2.6rem 1fr; gap: 1.25rem; position: relative; padding-bottom: 2.25rem; }
  li:not(:last-child)::before { content: ''; position: absolute; left: 1.3rem; top: 2.6rem; bottom: 0.25rem; width: 2px; background: var(--line); transform: translateX(-1px); }
  .n { width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font: 700 1.05rem var(--font-display); }
  li:last-child .n { background: var(--ok); }
  .body { display: grid; gap: 0.5rem; padding-top: 0.3rem; }
  .body p { color: var(--muted); }
  img { width: 100%; height: auto; border-radius: var(--radius-sm); border: 1px solid var(--line); margin-top: 0.75rem; }
</style>
